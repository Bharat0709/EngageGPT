    "webpack": "^5.91.0"
  },
  "scripts": {
    "start": "craco start",
    "start:fast": "cross-env FAST_REFRESH=true craco start",
    "build": "craco build",
    "build:analyze": "cross-env ANALYZE=true craco build",
    "build:speed": "cross-env MEASURE_SPEED=true craco build",
    "build:progress": "cross-env SHOW_PROGRESS=true craco build",
    "build:explorer": "cross-env GENERATE_SOURCEMAP=true craco build",
    "build:fast": "cross-env GENERATE_SOURCEMAP=false DISABLE_ESLINT_PLUGIN=true craco build",
    "build:profile": "cross-env ANALYZE=true MEASURE_SPEED=true SHOW_PROGRESS=true craco build",
    "build:clean": "rm -rf build .webpack-cache && npm run build",
    "test": "craco test",
    "serve": "serve -s build -l 3000",
    "size": "npm run build && bundlesize",
    "perf": "npm run build:profile && npm run size"
  },
  "bundlesize": [
    {
      "path": "./build/static/js/*.js",
      "maxSize": "500 kB"
    },
    {
      "path": "./build/static/css/*.css",
      "maxSize": "50 kB"
    }
  ],
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@craco/craco": "^7.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^7.0.3",
    "react-app-rewired": "^2.2.1",
    "serve": "^14.2.4",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.3",
    "tailwindcss-highlights": "^1.0.0",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
