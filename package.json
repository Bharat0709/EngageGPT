    "js-cookie": "^3.0.5",
    "moment-timezone": "^0.5.48",
    "postcss-cli": "^11.0.0",
    "react": "^18.2.0",
    "react-datepicker": "^8.2.1",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.4.1",
    "react-scripts": "5.0.1",
    "react-select": "^5.10.1",
    "react-spring": "^9.7.3",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
